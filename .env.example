# Секретный ключ для подписи и валидации JWT (ОБЯЗАТЕЛЬНО задать в окружении)
JWT_SECRET=change_me_to_strong_random_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Настройки Rate Limiting в API Gateway
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_REQUESTS=5
